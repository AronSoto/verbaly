{
  "name": "@verbaly/react",
  "version": "0.7.0",
  "description": "React bindings for Verbaly — hooks over the reactive core.",
  "keywords": [
    "i18n",
    "react",
    "hooks",
    "verbaly"
  ],
  "license": "Apache-2.0",
  "author": "Aron Soto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AronSoto/verbaly.git",
    "directory": "packages/react"
  },
  "homepage": "https://verbaly-web.vercel.app/docs/frameworks",
  "bugs": {
    "url": "https://github.com/AronSoto/verbaly/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "verbaly": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.10.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "verbaly": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  }
}
