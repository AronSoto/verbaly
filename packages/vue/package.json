{
  "name": "@verbaly/vue",
  "version": "0.8.0",
  "description": "Vue 3 bindings for Verbaly — composables over the reactive core.",
  "keywords": [
    "i18n",
    "vue",
    "composables",
    "verbaly"
  ],
  "license": "Apache-2.0",
  "author": "Aron Soto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AronSoto/verbaly.git",
    "directory": "packages/vue"
  },
  "homepage": "https://verbaly-web.vercel.app/docs/frameworks",
  "bugs": {
    "url": "https://github.com/AronSoto/verbaly/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "verbaly": "workspace:^",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "verbaly": "workspace:*",
    "vue": "^3.5.39"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  }
}
