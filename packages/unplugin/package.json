{
  "name": "@verbaly/unplugin",
  "version": "0.27.0",
  "description": "Verbaly for webpack, Rollup, esbuild and Rspack: extraction, virtual modules and build gate via unplugin.",
  "keywords": [
    "i18n",
    "unplugin",
    "webpack",
    "rollup",
    "esbuild",
    "rspack",
    "verbaly"
  ],
  "license": "MIT",
  "author": "Aron Soto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AronSoto/verbaly.git",
    "directory": "packages/unplugin"
  },
  "homepage": "https://verbaly-web.vercel.app/docs/vite",
  "bugs": {
    "url": "https://github.com/AronSoto/verbaly/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@verbaly/compiler": "workspace:*",
    "unplugin": "^3.3.0"
  },
  "peerDependencies": {
    "verbaly": "workspace:^"
  },
  "devDependencies": {
    "verbaly": "workspace:*"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  }
}
