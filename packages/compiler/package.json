{
  "name": "@verbaly/compiler",
  "version": "0.73.0",
  "description": "Message extraction and type-safe codegen for Verbaly.",
  "keywords": [
    "i18n",
    "compiler",
    "codegen",
    "verbaly"
  ],
  "license": "MIT",
  "author": "Aron Soto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AronSoto/verbaly.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://verbaly-web.vercel.app/docs/reference/cli",
  "bugs": {
    "url": "https://github.com/AronSoto/verbaly/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "verbaly": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "jiti": "^2.7.0",
    "jsonc-parser": "^3.3.1",
    "magic-string": "^1.4.3",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17",
    "verbaly": "workspace:*"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.110.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.3"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests && vitest run --config vitest.dom.config.ts",
    "typecheck": "tsc --noEmit"
  }
}
