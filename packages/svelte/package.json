{
  "name": "@verbaly/svelte",
  "version": "0.47.0",
  "description": "Svelte bindings for Verbaly: stores over the reactive core.",
  "keywords": [
    "i18n",
    "svelte",
    "stores",
    "verbaly"
  ],
  "license": "MIT",
  "author": "Aron Soto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AronSoto/verbaly.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://verbaly-web.vercel.app/docs/frameworks/svelte",
  "bugs": {
    "url": "https://github.com/AronSoto/verbaly/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Trans.svelte": {
      "types": "./dist/Trans.svelte.d.ts",
      "svelte": "./dist/Trans.svelte",
      "default": "./dist/Trans.svelte"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "verbaly": "workspace:^"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "happy-dom": "^20.12.0",
    "svelte": "^5.57.0",
    "verbaly": "workspace:^"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-svelte.mjs",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  }
}
