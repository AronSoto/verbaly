{
  "name": "@verbaly/nuxt",
  "version": "0.24.0",
  "description": "Nuxt integration for Verbaly: zero-config module with per-request locale negotiation and flash-free hydration.",
  "keywords": [
    "i18n",
    "nuxt",
    "nuxt-module",
    "ssr",
    "hydration",
    "verbaly"
  ],
  "license": "MIT",
  "author": "Aron Soto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AronSoto/verbaly.git",
    "directory": "packages/nuxt"
  },
  "homepage": "https://verbaly-web.vercel.app/docs/frameworks/vue",
  "bugs": {
    "url": "https://github.com/AronSoto/verbaly/issues"
  },
  "type": "module",
  "types": "./dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@verbaly/vite": "workspace:^"
  },
  "peerDependencies": {
    "@verbaly/vue": "workspace:^",
    "verbaly": "workspace:^",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@nuxt/schema": "^4.4.8",
    "@verbaly/vue": "workspace:*",
    "happy-dom": "^20.10.6",
    "verbaly": "workspace:*",
    "vue": "^3.5.39"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  }
}
