{
  "name": "@verbaly/vue",
  "version": "0.36.0",
  "description": "Vue 3 bindings for Verbaly: composables over the reactive core.",
  "keywords": [
    "i18n",
    "vue",
    "composables",
    "verbaly"
  ],
  "license": "MIT",
  "author": "Aron Soto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AronSoto/verbaly.git",
    "directory": "packages/vue"
  },
  "homepage": "https://verbaly-web.vercel.app/docs/frameworks",
  "bugs": {
    "url": "https://github.com/AronSoto/verbaly/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "verbaly": "workspace:^",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "happy-dom": "^20.11.1",
    "verbaly": "workspace:^",
    "vue": "^3.5.40"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  }
}
