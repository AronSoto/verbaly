{
  "name": "@verbaly/compiler",
  "version": "0.7.0",
  "description": "Message extraction and type-safe codegen for Verbaly.",
  "keywords": [
    "i18n",
    "compiler",
    "codegen",
    "verbaly"
  ],
  "license": "Apache-2.0",
  "author": "Aron Soto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AronSoto/verbaly.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/AronSoto/verbaly#readme",
  "bugs": {
    "url": "https://github.com/AronSoto/verbaly/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "verbaly": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/parser": "^8.0.0",
    "bundle-require": "^5.1.0",
    "magic-string": "^0.30.21",
    "tinyglobby": "^0.2.17",
    "verbaly": "workspace:*"
  },
  "peerDependencies": {
    "esbuild": ">=0.18"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  }
}
