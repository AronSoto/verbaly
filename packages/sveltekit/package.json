{
  "name": "@verbaly/sveltekit",
  "version": "0.34.0",
  "description": "SvelteKit SSR integration for Verbaly: per-request locale negotiation and flash-free hydration.",
  "keywords": [
    "i18n",
    "sveltekit",
    "ssr",
    "hydration",
    "verbaly"
  ],
  "license": "MIT",
  "author": "Aron Soto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AronSoto/verbaly.git",
    "directory": "packages/sveltekit"
  },
  "homepage": "https://verbaly-web.vercel.app/docs/sveltekit",
  "bugs": {
    "url": "https://github.com/AronSoto/verbaly/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "verbaly": "workspace:^"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.1",
    "svelte": "^5.56.8",
    "verbaly": "workspace:^"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  }
}
