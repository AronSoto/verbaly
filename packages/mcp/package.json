{
  "name": "@verbaly/mcp",
  "version": "0.36.0",
  "description": "MCP server for Verbaly: translation status, missing keys, extraction and machine translation as tools for coding agents.",
  "keywords": [
    "i18n",
    "mcp",
    "model-context-protocol",
    "agent",
    "verbaly"
  ],
  "license": "MIT",
  "author": "Aron Soto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AronSoto/verbaly.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://verbaly-web.vercel.app/docs/reference/cli",
  "bugs": {
    "url": "https://github.com/AronSoto/verbaly/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "verbaly-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@verbaly/compiler": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  }
}
