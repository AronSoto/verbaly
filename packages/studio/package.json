{
  "name": "@verbaly/studio",
  "version": "0.57.0",
  "description": "Local review server for Verbaly: read, edit and approve translations over the JSON files already in your repo. No account, no database.",
  "keywords": [
    "i18n",
    "translations",
    "localhost",
    "editor",
    "verbaly"
  ],
  "license": "MIT",
  "author": "Aron Soto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AronSoto/verbaly.git",
    "directory": "packages/studio"
  },
  "homepage": "https://verbaly-web.vercel.app/docs/guide/studio",
  "bugs": {
    "url": "https://github.com/AronSoto/verbaly/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "verbaly-studio": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@verbaly/compiler": "workspace:^"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "verbaly": "workspace:^"
  },
  "scripts": {
    "build": "tsdown && vite build",
    "dev": "vite",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  }
}
