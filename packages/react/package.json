{
  "name": "@verbaly/react",
  "version": "0.41.0",
  "description": "React bindings for Verbaly: hooks over the reactive core.",
  "keywords": [
    "i18n",
    "react",
    "hooks",
    "verbaly"
  ],
  "license": "MIT",
  "author": "Aron Soto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AronSoto/verbaly.git",
    "directory": "packages/react"
  },
  "homepage": "https://verbaly-web.vercel.app/docs/frameworks",
  "bugs": {
    "url": "https://github.com/AronSoto/verbaly/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "verbaly": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "happy-dom": "^20.11.6",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "verbaly": "workspace:^"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests && vitest run --config vitest.preact.config.ts",
    "typecheck": "tsc --noEmit"
  }
}
